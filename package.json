{
  "name": "sig-node-board-assistant",
  "version": "0.1.4",
  "private": true,
  "description": "Chrome extension: Jev-judged suggestions for the SIG Node GitHub project boards, TestGrid dashboards, and pull request and issue pages.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "watch": "node scripts/build.mjs --watch",
    "watch:test": "node scripts/build.mjs --watch --test",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "judge": "esbuild scripts/judge.ts --bundle --platform=node --format=esm --outfile=dist/judge.mjs --log-level=warning && node dist/judge.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.8.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-paginate-rest": "^15.0.0",
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
