{
  "manifest_version": 3,
  "name": "SIG Node Board Assistant",
  "version": "0.1.5",
  "description": "Jev-judged suggestions for the SIG Node GitHub project boards and TestGrid dashboards, with the evidence behind each.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*",
    "https://testgrid.k8s.io/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/orgs/kubernetes/projects/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/kubernetes/*/pull/*",
        "https://github.com/kubernetes/*/issues/*",
        "https://github.com/kubernetes-sigs/*/pull/*",
        "https://github.com/kubernetes-sigs/*/issues/*"
      ],
      "js": ["item.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://testgrid.k8s.io/*"],
      "js": ["testgrid.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "SIG Node Board Assistant: settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["https://github.com/*"]
    }
  ]
}
