{
  "manifest_version": 3,
  "name": "SIG Node Board Assistant",
  "version": "0.1.0",
  "description": "Jev-judged triage hints on the SIG Node GitHub project boards. Read-only: it never writes to GitHub.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://api.typesafe.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/orgs/*/projects/*", "https://github.com/users/*/projects/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*/*/pull/*", "https://github.com/*/*/issues/*"],
      "js": ["item.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "SIG Node Board Assistant: settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["https://github.com/*"]
    }
  ]
}
